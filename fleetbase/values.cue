// Code generated by timoni.
// Note that this file must have no imports and all values must be concrete.

@if(!debug)

package main

// Default values for the Fleetbase Timoni module.
// This is the CUE equivalent of Helm's values.yaml.
values: {
	// Fleetbase API (FrankenPHP) backend settings
	app: {
		image: {
			repository: "docker.io/fleetbase/fleetbase-api"
			tag:        "v0.7.68"
			digest:     ""
		}
		replicas:    1
		port:        8000
		environment: "development"
		resources: {
			requests: {
				cpu:    "100m"
				memory: "256Mi"
			}
			limits: {
				cpu:    "1000m"
				memory: "1Gi"
			}
		}
		// Autoscaling settings for the application deployment
		autoscaling: {
			enabled:                        false
			minReplicas:                    1
			maxReplicas:                    5
			targetCPUUtilizationPercentage: 80
		}
		// Persistent volume for /fleetbase/api/storage/app
		persistence: {
			enabled: true
			size:    "10Gi"
		}
		// Application encryption key (required by Laravel)
		key: "base64:hyts2W3knDncDxQ0gRgf8cCGHRTgGyZh0RoAEhCr1kQ="
		// Console origin allowed by CORS
		consoleHost: "http://localhost:4200"
		securityContext: {
			capabilities: {
				drop: ["ALL"]
				add: ["CHOWN", "DAC_OVERRIDE", "SETUID", "SETGID", "NET_BIND_SERVICE"]
			}
		}
		service: {
			port: 8000
			type: "ClusterIP"
		}
	}

	serviceAccount: {
		// Specifies whether a service account should be created
		create: true
		// Annotations to add to the service account
		annotations: {}
		// The name of the service account to use.
		// If not set and create is true, a name is generated using the fullname template
		name: ""
	}

	// Disable automounting API credentials in pods
	automountServiceAccountToken: false

	// Nginx reverse proxy fronting the API
	httpd: {
		image: {
			repository: "docker.io/nginx"
			tag:        "stable-alpine"
			digest:     ""
		}
		replicas: 1
		port:     80
		service: {
			port: 80
			type: "ClusterIP"
		}
		resources: {
			requests: {
				cpu:    "20m"
				memory: "64Mi"
			}
			limits: {
				cpu:    "200m"
				memory: "256Mi"
			}
		}
		securityContext: {
			capabilities: {
				drop: ["ALL"]
				add: ["CHOWN", "SETUID", "SETGID", "NET_BIND_SERVICE"]
			}
		}
		autoscaling: {
			enabled:                        false
			minReplicas:                    1
			maxReplicas:                    5
			targetCPUUtilizationPercentage: 80
		}
	}

	// Fleetbase Console web UI (Ember.js)
	console: {
		image: {
			repository: "docker.io/fleetbase/fleetbase-console"
			tag:        "v0.7.68"
			digest:     ""
		}
		enabled:    true
		replicas:   1
		port:       4200
		service: {
			port: 4200
			type: "ClusterIP"
		}
		apiHost:    "http://localhost:8000"
		socketHost: "localhost"
		socketPort: 38000
		resources: {
			requests: {
				cpu:    "20m"
				memory: "64Mi"
			}
			limits: {
				cpu:    "200m"
				memory: "128Mi"
			}
		}
		securityContext: {
			capabilities: {
				drop: ["ALL"]
				add: ["CHOWN", "SETUID", "SETGID", "NET_BIND_SERVICE"]
			}
		}
		autoscaling: {
			enabled:                        false
			minReplicas:                    1
			maxReplicas:                    5
			targetCPUUtilizationPercentage: 80
		}
	}

	// Background queue worker (artisan queue:work)
	queue: {
		enabled:  true
		replicas: 1
		resources: {
			requests: {
				cpu:    "100m"
				memory: "256Mi"
			}
			limits: {
				cpu:    "500m"
				memory: "512Mi"
			}
		}
		securityContext: {
			capabilities: {
				drop: ["ALL"]
				add: ["CHOWN", "DAC_OVERRIDE", "SETUID", "SETGID", "NET_BIND_SERVICE"]
			}
		}
		autoscaling: {
			enabled:                        false
			minReplicas:                    1
			maxReplicas:                    5
			targetCPUUtilizationPercentage: 80
		}
	}

	// Scheduled task cron daemon (go-crond)
	scheduler: {
		enabled:  true
		replicas: 1
		resources: {
			requests: {
				cpu:    "50m"
				memory: "128Mi"
			}
			limits: {
				cpu:    "200m"
				memory: "256Mi"
			}
		}
		securityContext: {
			capabilities: {
				drop: ["ALL"]
				add: ["CHOWN", "DAC_OVERRIDE", "SETUID", "SETGID", "NET_BIND_SERVICE"]
			}
		}
	}

	// Real-time event broker (SocketCluster)
	socket: {
		image: {
			repository: "docker.io/socketcluster/socketcluster"
			tag:        "v20.0.2"
			digest:     ""
		}
		enabled:  true
		replicas: 1
		port:     8000
		service: {
			port: 8000
			type: "ClusterIP"
		}
		workers:  10
		brokers:  10
		options:  "{\"origins\":\"http://localhost:*,https://localhost:*,ws://localhost:*,wss://localhost:*\"}"
		resources: {
			requests: {
				cpu:    "50m"
				memory: "128Mi"
			}
			limits: {
				cpu:    "500m"
				memory: "512Mi"
			}
		}
		securityContext: {
			capabilities: {
				drop: ["ALL"]
				add: ["NET_BIND_SERVICE"]
			}
		}
		autoscaling: {
			enabled:                        false
			minReplicas:                    1
			maxReplicas:                    5
			targetCPUUtilizationPercentage: 80
		}
	}

	// Database (MySQL) StatefulSet configuration
	// When enabled=true, runs in-cluster MySQL
	// When enabled=false, set database.url or database.urlSecretRef for external DB (e.g. AWS RDS)
	database: {
		image: {
			repository: "docker.io/mysql"
			tag:        "8.0-oracle"
			digest:     ""
		}
		enabled:            true
		name:               "fleetbase"
		user:               "root"
		password:           "fleetbase"
		allowEmptyPassword: true
		service: {
			port: 3306
			type: "ClusterIP"
		}
		persistence: {
			enabled: true
			size:    "10Gi"
		}
		resources: {
			requests: {
				cpu:    "100m"
				memory: "512Mi"
			}
			limits: {
				cpu:    "1000m"
				memory: "1Gi"
			}
		}
		podSecurityContext: {
			fsGroup:      999
			runAsUser:    999
			runAsGroup:   999
			runAsNonRoot: true
		}
		securityContext: {
			runAsUser:    999
			runAsGroup:   999
			runAsNonRoot: true
			capabilities: {
				drop: ["ALL"]
			}
		}
	}

	// Cache & message bus (Redis) StatefulSet configuration
	// When enabled=true, runs in-cluster Redis
	// When enabled=false, set cache.url or cache.urlSecretRef for external Redis (e.g. AWS ElastiCache)
	cache: {
		image: {
			repository: "docker.io/valkey/valkey"
			tag:        "9.2"
			digest:     ""
		}
		enabled: true
		port:    6379
		service: {
			port: 6379
			type: "ClusterIP"
		}
		persistence: {
			enabled: true
			size:    "10Gi"
		}
		resources: {
			requests: {
				cpu:    "20m"
				memory: "64Mi"
			}
			limits: {
				cpu:    "200m"
				memory: "256Mi"
			}
		}
		podSecurityContext: {
			fsGroup:      999
			runAsUser:    999
			runAsGroup:   999
			runAsNonRoot: true
		}
		securityContext: {
			runAsUser:    999
			runAsGroup:   999
			runAsNonRoot: true
			capabilities: {
				drop: ["ALL"]
			}
		}
	}

	// Database migration batch job 
	migration: {
		enabled: true
		resources: {
			requests: {
				cpu:    "100m"
				memory: "256Mi"
			}
			limits: {
				cpu:    "1000m"
				memory: "1Gi"
			}
		}
	}

	// -- Gateway API HTTPRoute exposure to an existing Gateway.
	gatewayAPI: {
		// -- Enable this capability.
		enabled: true
		// -- GatewayClass name.
		gatewayClassName: ""
		// -- Route definitions with parentRefs, hostnames, rules, labels and annotations.
		httpRoutes: [
			{
				name: ""
				// -- Route labels.
				labels: {}
				// -- Route annotations.
				annotations: {}
				// -- References to parent Gateways.
				parentRefs: [
					{
						// -- Gateway name.
						name: "shared-gtw"
						// -- Gateway namespace (optional, defaults to route namespace).
						namespace: "kube-system"
						// -- Gateway API group.
						group: "gateway.networking.k8s.io"
						// -- Gateway API kind.
						kind: "Gateway"
						// -- Gateway section name.
						sectionName: ""
						// -- Gateway listener port.
						port: 80
					},
				]
				// -- Hostnames matching the route.
				hostnames: ["localhost"]
				// -- Routing rules, match conditions, filters and backend references.
				rules: [
					// 1. API routes -> HTTPD
					{
						matches: [
							{path: {type: "PathPrefix", value: "/int"}},
							{path: {type: "PathPrefix", value: "/v1"}},
							{path: {type: "PathPrefix", value: "/ledger"}},
							{path: {type: "PathPrefix", value: "/fleetops"}},
							{path: {type: "PathPrefix", value: "/storefront"}},
							{path: {type: "PathPrefix", value: "/customer-portal"}},
							{path: {type: "PathPrefix", value: "/iam"}},
							{path: {type: "PathPrefix", value: "/pallet"}},
							{path: {type: "PathPrefix", value: "/dev"}},
							{path: {type: "PathPrefix", value: "/ai"}},
							{path: {type: "PathPrefix", value: "/registry"}},
							{path: {type: "PathPrefix", value: "/valhalla"}},
							{path: {type: "PathPrefix", value: "/vroom"}},
							{path: {type: "PathPrefix", value: "/stripe"}},
							{path: {type: "PathPrefix", value: "/webhooks"}},
							{path: {type: "PathPrefix", value: "/sanctum"}},
							{path: {type: "PathPrefix", value: "/public"}},
							{path: {type: "PathPrefix", value: "/health"}},
						]
						backendRefs: [
							{
								name: "fleetbase-httpd"
								port: 80
							},
						]
					},
					// 2. Real-time WebSockets -> SocketCluster
					{
						matches: [
							{path: {type: "PathPrefix", value: "/socketcluster"}},
						]
						backendRefs: [
							{
								name: "fleetbase-socket"
								port: 8000
							},
						]
					},
					// 3. Console SPA -> Console
					{
						matches: [
							{path: {type: "PathPrefix", value: "/"}},
						]
						backendRefs: [
							{
								name: "fleetbase-console"
								port: 4200
							},
						]
					},
				]
			},
		]
	}
}
