// Code generated by timoni.
// Note that this file must have no imports and all values must be concrete.
// Reference: https://github.com/helmforgedev/charts/blob/main/charts/ntfy/values.yaml

@if(!debug)

package main

// =============================================================================
// ntfy Timoni Module - Default Values (mirrors charts/ntfy/values.yaml)
// =============================================================================
// Note: List defaults live in templates/config.cue so user values files can
// override lists with any length without CUE list-length unification errors.
values: {
	global: {}

	nameOverride:     ""
	fullnameOverride: ""
	commonLabels: {}
	// -- Annotations applied to every module-owned Kubernetes resource
	commonAnnotations: {}

	// =============================================================================
	// Image
	// =============================================================================

	image: {
		// -- ntfy container image
		repository: "docker.io/binwiederhier/ntfy"
		// -- Image tag
		tag:        "v2.32.0"
		pullPolicy: "IfNotPresent"
	}

	// imagePullSecrets: []

	containerPorts: {
		// -- Port on which the ntfy process listens inside the container.
		http: 2586
	}

	// =============================================================================
	// ntfy Configuration
	// =============================================================================

	ntfy: {
		// -- Public base URL of the instance (e.g. https://ntfy.example.com)
		baseUrl: ""
		// -- Default access for unauthenticated users (read-write, read-only, write-only, deny-all)
		authDefaultAccess: "read-write"
		// -- Initial administrator account created on startup/bootstrap
		admin: {
			// -- Enable automatic administrator user creation
			enabled: true
			// -- Admin username
			username: "admin"
			// -- Admin password (required when enabled and no existingSecret provided)
			password: "Changeit@123."
			// -- Role to assign to the user (admin, user)
			role: "admin"
			// -- Existing secret containing admin credentials
			existingSecret: ""
			// -- Key in existing secret containing the admin password
			existingSecretPasswordKey: "password"
			// -- Key in existing secret containing the admin username (optional)
			existingSecretUsernameKey: ""
			// -- Annotations to add to the managed admin Secret
			annotations: {}
		}
		// -- Enable behind-proxy mode (trust X-Forwarded-For headers)
		behindProxy: true
		// -- Enable Prometheus metrics endpoint at /metrics
		enableMetrics: false
		// -- Separate metrics listen address (e.g. :9090). Empty uses main port.
		metricsListenHttp: ""
		// -- Attachment total size limit per visitor (e.g. 100M)
		attachmentTotalSizeLimit: ""
		// -- Attachment file size limit (e.g. 15M)
		attachmentFileSizeLimit: ""
		// -- Attachment expiry duration (e.g. 3h)
		attachmentExpiryDuration: ""
		// -- Abuse ban-feed configuration for an external fail2ban or equivalent consumer
		banFeed: {
			// -- Enable the abuse ban-feed
			enabled: false
			// -- Writable file where confirmed abusive visitors are appended
			file: "/var/cache/ntfy/ban.log"
			// -- Rolling window used to count weighted strikes per visitor prefix
			window: "10m"
			// -- Weighted strikes per window before a visitor prefix is written to the ban file
			threshold: 100
			// -- Per-code weights in KEY:WEIGHT format; longest match wins (default in templates/config.cue)
			// weights: ["42909:10"]
		}
		// -- Extra server.yml configuration lines (appended to ConfigMap)
		extraConfig: ""
		// -- Extra environment variables for the container
		// extraEnv: []
		// -- Database configuration for message cache, access control, and web push.
		// When enabled, SQLite file options are omitted.
		database: {
			// -- Database mode: sqlite | postgresql
			mode: "postgresql"
			// -- External PostgreSQL configuration (used when postgresql is disabled)
			external: {
				host:     ""
				port:     "5432"
				name:     "ntfy"
				username: "ntfy"
				password: ""
				// -- Existing secret containing the database password
				existingSecret: ""
				// -- Key in the existing secret containing the password
				existingSecretPasswordKey: "password"
				// -- Or existing secret containing the full connection URL (e.g. postgres://user:pass@host:5432/db)
				existingSecretUrlKey: "database-url"
			}
			// -- Legacy existingSecret containing the full PostgreSQL connection URL
			existingSecret: ""
			// -- Key in the legacy existingSecret
			existingSecretKey: "database-url"
			// -- Deprecated: use postgresql.enabled or database.mode=postgresql instead
			enabled: false
		}
	}

	// =============================================================================
	// PostgreSQL Companion
	// =============================================================================

	postgresql: {
		// -- Connect to an accompanying PostgreSQL instance (<name>-postgresql)
		enabled:      true
		architecture: "standalone"
		host:         ""
		image: {
			// -- PostgreSQL container image
			repository: "docker.io/library/postgres"
			// -- Image tag
			tag:        "18.6-trixie"
			pullPolicy: "IfNotPresent"
		}
		auth: {
			database:                      "ntfy"
			username:                      "ntfy"
			password:                      "postgresql-password"
			existingSecret:                ""
			existingSecretUserPasswordKey: "user-password"
		}
		persistence: {
			enabled:      true
			size:         "8Gi"
			storageClass: ""
		}
		resources: {
			requests: {
				cpu:    "250m"
				memory: "512Mi"
			}
			limits: {
				cpu:    "500m"
				memory: "1Gi"
			}
		}
		podSecurityContext: {
			runAsNonRoot:        true
			runAsUser:           999
			runAsGroup:          999
			fsGroup:             999
			fsGroupChangePolicy: "OnRootMismatch"
			seccompProfile: type: "RuntimeDefault"
		}
		securityContext: {
			allowPrivilegeEscalation: false
			privileged:               false
			readOnlyRootFilesystem:   false
			runAsNonRoot:             true
			runAsUser:                999
			runAsGroup:               999
			capabilities: drop: ["ALL"]
		}
	}

	// =============================================================================
	// External Secrets Operator
	// =============================================================================

	externalSecrets: {
		// -- Render ExternalSecret resources
		enabled: false
		// -- Default refresh interval for ExternalSecret resources
		refreshInterval: "1h"
		// -- ExternalSecret definitions with complete spec blocks
		// items: []
	}

	// =============================================================================
	// Persistence
	// =============================================================================

	persistence: {
		// -- Enable persistence for cache and auth databases
		enabled: true
		// -- Storage size
		size: "2Gi"
		// -- Storage class
		storageClass: ""
		// -- Access modes (default in templates/config.cue)
		// accessModes: ["ReadWriteOnce"]
		// -- Use an existing PVC
		existingClaim: ""
		// -- Maximum data storage when persistence is disabled.
		emptyDirSizeLimit: "1Gi"
	}

	// =============================================================================
	// Service Account
	// =============================================================================

	serviceAccount: {
		// -- Create a ServiceAccount
		create: false
		// -- ServiceAccount name
		name: ""
		// -- Annotations for the ServiceAccount
		annotations: {}
		// -- Mount the Kubernetes API token into ntfy and backup pods.
		automountServiceAccountToken: false
	}

	// =============================================================================
	// Service
	// =============================================================================

	service: {
		// -- Service type
		type: "ClusterIP"
		// -- HTTP service port
		port: 80
		// -- Annotations for the Service
		annotations: {}
		// -- Service IP family policy: SingleStack | PreferDualStack | RequireDualStack. null uses cluster default.
		ipFamilyPolicy: null
		// -- Service IP families override. Empty uses cluster default.
		// ipFamilies: []
	}

	// =============================================================================
	// Gateway API
	// =============================================================================

	gateway: {
		// -- Enable Gateway API HTTPRoute (alternative to Ingress; requires Gateway API CRDs)
		enabled: true
		// -- Annotations for the HTTPRoute
		annotations: {}
		// -- parentRefs pointing to your Gateway resource
		parentRefs: [
			{
				name:      "shared-gtw"
				namespace: "kube-system"
			},
		]
		// -- Hostnames the HTTPRoute matches
		// hostnames: []
		// -- Path prefix
		path: "/"
		// -- Path match type
		pathType: "PathPrefix"
	}

	// =============================================================================
	// Probes
	// =============================================================================

	probes: {
		startup: {
			enabled:             true
			path:                "/v1/health"
			initialDelaySeconds: 5
			periodSeconds:       5
			timeoutSeconds:      3
			failureThreshold:    30
		}
		liveness: {
			enabled:             true
			path:                "/v1/health"
			initialDelaySeconds: 0
			periodSeconds:       15
			timeoutSeconds:      5
			failureThreshold:    3
		}
		readiness: {
			enabled:             true
			path:                "/v1/health"
			initialDelaySeconds: 0
			periodSeconds:       10
			timeoutSeconds:      5
			failureThreshold:    3
		}
	}

	// =============================================================================
	// Metrics (Prometheus)
	// =============================================================================

	metrics: {
		// -- Create a ServiceMonitor for Prometheus Operator
		serviceMonitor: {
			enabled: false
			// -- Interval for Prometheus scraping
			interval: "30s"
			// -- Additional labels for the ServiceMonitor
			labels: {}
		}
	}

	// =============================================================================
	// Resources and Security
	// =============================================================================

	resources: {
		requests: {
			cpu:    "50m"
			memory: "64Mi"
		}
		limits: {
			cpu:    "500m"
			memory: "256Mi"
		}
	}

	podSecurityContext: {
		runAsNonRoot:        true
		runAsUser:           1000
		runAsGroup:          1000
		fsGroup:             1000
		fsGroupChangePolicy: "OnRootMismatch"
		seccompProfile: type: "RuntimeDefault"
	}

	securityContext: {
		allowPrivilegeEscalation: false
		privileged:               false
		readOnlyRootFilesystem:   true
		capabilities: drop: ["ALL"]
	}

	runtimeStorage: {
		// -- Maximum writable temporary storage for ntfy and its init containers.
		tmpSizeLimit: "128Mi"
	}

	// =============================================================================
	// Scheduling
	// =============================================================================

	nodeSelector: {}
	// tolerations: []
	affinity: {}
	// topologySpreadConstraints: []
	priorityClassName:             ""
	terminationGracePeriodSeconds: 30

	podLabels: {}
	podAnnotations: {}

	podDisruptionBudget: {
		// -- Protect the singleton ntfy pod from voluntary disruption.
		enabled: false
		// -- Minimum available ntfy pods during voluntary disruption.
		minAvailable: 1
		// -- Alternative maximum unavailable value; set minAvailable to null when used.
		maxUnavailable: null
	}

	// =============================================================================
	// Extra
	// =============================================================================

	// extraVolumes: []
	// extraVolumeMounts: []
	// -- Extra manifests to deploy alongside the module
	// extraManifests: []

	// =============================================================================
	// Backup (S3 CronJob)
	// =============================================================================

	backup: {
		// -- Enable S3 backup CronJob for cache, SQLite databases, and attachments
		enabled: false
		// -- Cron schedule (default: daily at 03:00 UTC)
		schedule: "0 3 * * *"
		// -- Suspend the CronJob
		suspend: false
		// -- Concurrency policy
		concurrencyPolicy: "Forbid"
		// -- Successful job history limit
		successfulJobsHistoryLimit: 3
		// -- Failed job history limit
		failedJobsHistoryLimit: 3
		// -- Backoff limit
		backoffLimit: 1
		// -- Archive filename prefix
		archivePrefix: "ntfy"
		images: {
			// -- Image for creating tar archives
			archiver: "docker.io/library/alpine:3.22"
			// -- Image for uploading to S3
			uploader: "docker.io/helmforge/mc:1.0.0"
		}
		// -- Resource requests and limits for backup jobs
		resources: {}
		// -- Maximum ephemeral archive size used by each backup Job.
		scratchSizeLimit: "3Gi"
		// -- Maximum writable temporary storage used by backup containers.
		tmpSizeLimit: "64Mi"
		serviceAccount: {
			// -- Create a dedicated ServiceAccount for workload identity backups
			create: true
			// -- Existing dedicated ServiceAccount name when create is false
			name: ""
			// -- Annotations for IRSA or another workload identity integration
			annotations: {}
			// -- Mount the Kubernetes API token into backup pods
			automountServiceAccountToken: false
		}
		s3: {
			// -- S3-compatible endpoint URL
			endpoint: ""
			// -- S3 bucket name
			bucket: ""
			// -- S3 key prefix
			prefix: "ntfy"
			// -- Create the bucket if it does not exist; requires bucket-management permission
			createBucketIfNotExists: false
			// -- Existing secret name containing S3 credentials
			existingSecret: ""
			// -- Secret key for access key in existing secret
			existingSecretAccessKeyKey: "access-key"
			// -- Secret key for secret key in existing secret
			existingSecretSecretKeyKey: "secret-key"
			// -- Inline access key
			accessKey: ""
			// -- Inline secret key
			secretKey: ""
			// -- AWS region used by workload identity and regional bucket creation
			region: ""
			// -- Use EKS Pod Identity or IRSA instead of static S3 credentials
			credentialsFromPodIdentity: false
		}
	}

	// =============================================================================
	// OIDC (Single Sign-On)
	// =============================================================================

	oidc: {
		// -- Enable OpenID Connect authentication
		enabled: false
		// -- OIDC provider issuer URL
		issuerUrl: ""
		// -- Client ID registered with the OIDC provider
		clientId: ""
		// -- Client secret for OIDC (stored in a Secret)
		clientSecret: ""
		// -- Name of an existing Secret containing the OIDC client secret
		existingSecret: ""
		// -- Key within existingSecret containing the client secret
		existingSecretKey: "client-secret"
		// -- OIDC redirect URL (as configured in IdP)
		redirectUrl: ""
		// -- URL to redirect to after logout
		logoutRedirectUrl: ""
		// -- Default access grant for OIDC users (read-write, read-only, deny-all)
		defaultAccess: "read-write"
	}

	// =============================================================================
	// SMTP (Outbound Email Notifications)
	// =============================================================================

	smtp: {
		// -- Enable SMTP email notifications
		enabled: false
		// -- SMTP server address (host:port)
		senderAddr: ""
		// -- SMTP sender email address
		senderFrom: ""
		// -- SMTP username for authentication
		senderUser: ""
		// -- SMTP password for authentication (stored in a Secret)
		senderPass: ""
		// -- Name of an existing Secret containing the SMTP password
		existingSecret: ""
		// -- Key within existingSecret containing the password
		existingSecretPasswordKey: "smtp-password"
		// -- Require verified email addresses for notifications
		senderVerify: false
	}
}
